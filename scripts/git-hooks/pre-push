#!/bin/sh
# ─────────────────────────────────────────────────────────────────────────────
# HALQA Pre-Push Hook — Branch & Safety Guard
# Blocks force-push to protected branches and warns on large pushes
# ─────────────────────────────────────────────────────────────────────────────

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

PROTECTED_BRANCHES="main master"
REMOTE="$1"
URL="$2"

while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
  BRANCH=$(echo "$REMOTE_REF" | sed 's|refs/heads/||')
  
  # Block push to protected branches with force indicators
  for PROTECTED in $PROTECTED_BRANCHES; do
    if [ "$BRANCH" = "$PROTECTED" ]; then
      # Check if this looks like a force push (non-fast-forward)
      if [ "$REMOTE_SHA" != "0000000000000000000000000000000000000000" ]; then
        if ! git merge-base --is-ancestor "$REMOTE_SHA" "$LOCAL_SHA" 2>/dev/null; then
          echo "${RED}❌ BLOCKED: Non-fast-forward push to protected branch '$BRANCH'${NC}"
          echo "   This would rewrite history on a protected branch."
          echo "   If this is intentional, use: git push --force-with-lease"
          echo "   But ONLY after team review — never force-push to main."
          exit 1
        fi
      fi
      
      echo "${YELLOW}⚠  Pushing to protected branch '$BRANCH' — ensure CI passes first.${NC}"
    fi
  done
  
  # Warn if pushing a large number of commits at once
  if [ "$REMOTE_SHA" = "0000000000000000000000000000000000000000" ]; then
    COMMIT_COUNT=$(git rev-list --count "$LOCAL_SHA" 2>/dev/null || echo 0)
  else
    COMMIT_COUNT=$(git rev-list --count "$REMOTE_SHA..$LOCAL_SHA" 2>/dev/null || echo 0)
  fi
  
  if [ "$COMMIT_COUNT" -gt 50 ]; then
    echo "${YELLOW}⚠  WARNING: Pushing $COMMIT_COUNT commits at once to $BRANCH${NC}"
    echo "   Consider opening a PR for review on large changesets."
  fi
done

echo "${GREEN}✅ Pre-push checks passed.${NC}"
exit 0
