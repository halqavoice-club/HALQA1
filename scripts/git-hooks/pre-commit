#!/bin/sh
# ─────────────────────────────────────────────────────────────────────────────
# HALQA Pre-Commit Hook — Secret & Safety Scanner
# Blocks commits that contain secrets, .env files, node_modules, or large files
# Install: copy to .git/hooks/pre-commit  (done automatically by setup script)
# ─────────────────────────────────────────────────────────────────────────────

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

ERRORS=0

echo "🔍 Running HALQA pre-commit checks..."

# ── 1. Block .env files ──────────────────────────────────────────────────────
ENV_FILES=$(git diff --cached --name-only | grep -E '\.env$|\.env\.|\.env\.local|\.env\.production|\.env\.docker')
if [ -n "$ENV_FILES" ]; then
  echo "${RED}❌ BLOCKED: .env files staged for commit:${NC}"
  echo "$ENV_FILES"
  echo "   Remove with: git reset HEAD <file>"
  ERRORS=$((ERRORS + 1))
fi

# ── 2. Block node_modules ────────────────────────────────────────────────────
NODE_MODULES=$(git diff --cached --name-only | grep 'node_modules/')
if [ -n "$NODE_MODULES" ]; then
  echo "${RED}❌ BLOCKED: node_modules staged for commit${NC}"
  echo "   Run: echo 'node_modules/' >> .gitignore && git rm -r --cached node_modules/"
  ERRORS=$((ERRORS + 1))
fi

# ── 3. Block build artifacts ─────────────────────────────────────────────────
BUILD_FILES=$(git diff --cached --name-only | grep -E '^(dist/|build/|\.next/|out/|mobile/dist/)')
if [ -n "$BUILD_FILES" ]; then
  echo "${RED}❌ BLOCKED: Build artifacts staged:${NC}"
  echo "$BUILD_FILES"
  ERRORS=$((ERRORS + 1))
fi

# ── 4. Block large files (> 5 MB) ────────────────────────────────────────────
LARGE_FILES=$(git diff --cached --name-only | while read -r f; do
  if [ -f "$f" ]; then
    SIZE=$(wc -c < "$f" 2>/dev/null || echo 0)
    if [ "$SIZE" -gt 5242880 ]; then
      echo "$f ($(( SIZE / 1024 / 1024 ))MB)"
    fi
  fi
done)
if [ -n "$LARGE_FILES" ]; then
  echo "${RED}❌ BLOCKED: Files > 5MB staged:${NC}"
  echo "$LARGE_FILES"
  echo "   Use Git LFS or store in cloud storage instead."
  ERRORS=$((ERRORS + 1))
fi

# ── 5. Scan for secret patterns ──────────────────────────────────────────────
SECRET_PATTERNS='(sk_live_|sk_test_|pk_live_|pk_test_|whsec_|AIza[0-9A-Za-z_-]{35}|ya29\.[0-9A-Za-z_-]+|AKIA[0-9A-Z]{16}|[0-9a-z]{32}-us[0-9]{1,2}|livekit.*secret|firebase.*private_key|-----BEGIN (RSA |EC )?PRIVATE KEY)'

STAGED_FILES=$(git diff --cached --name-only | grep -v '^\.gitignore$')
SECRET_FOUND=""

for FILE in $STAGED_FILES; do
  if [ -f "$FILE" ]; then
    # Skip binary files and known-safe files
    case "$FILE" in
      *.png|*.jpg|*.jpeg|*.gif|*.ico|*.woff|*.woff2|*.ttf|*.eot|*.apk|*.aab) continue ;;
      *.example|*EXAMPLE*) continue ;;
    esac
    
    MATCH=$(git diff --cached -- "$FILE" | grep '^+' | grep -v '^+++' | grep -iE "$SECRET_PATTERNS" 2>/dev/null)
    if [ -n "$MATCH" ]; then
      SECRET_FOUND="$SECRET_FOUND\n  $FILE"
    fi
  fi
done

if [ -n "$SECRET_FOUND" ]; then
  echo "${RED}❌ BLOCKED: Possible secrets detected in:${NC}"
  echo "$SECRET_FOUND"
  echo "   Move secrets to .env files and reference via process.env"
  ERRORS=$((ERRORS + 1))
fi

# ── 6. Block APK/AAB binaries ────────────────────────────────────────────────
BINARIES=$(git diff --cached --name-only | grep -E '\.(apk|aab|ipa|dex)$')
if [ -n "$BINARIES" ]; then
  echo "${RED}❌ BLOCKED: Binary build artifacts staged:${NC}"
  echo "$BINARIES"
  ERRORS=$((ERRORS + 1))
fi

# ── 7. Validate commit message format (conventional commits) ─────────────────
# Only applies when COMMIT_EDITMSG exists (normal commits, not merges/rebases)
COMMIT_MSG_FILE=".git/COMMIT_EDITMSG"
if [ -f "$COMMIT_MSG_FILE" ]; then
  COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")
  VALID_PATTERN='^(feat|fix|docs|style|refactor|perf|test|chore|ci|build|revert)(\(.+\))?: .{1,100}$'
  if ! echo "$COMMIT_MSG" | grep -qE "$VALID_PATTERN"; then
    echo "${YELLOW}⚠  WARNING: Commit message does not follow Conventional Commits format${NC}"
    echo "   Expected: type(scope): description"
    echo "   Examples: feat(auth): add refresh token rotation"
    echo "             fix(live): resolve moderator mute bug"
    echo "             docs: update deployment guide"
    echo "   Your message: $COMMIT_MSG"
    # Warning only — not blocking
  fi
fi

# ── Result ───────────────────────────────────────────────────────────────────
if [ "$ERRORS" -gt 0 ]; then
  echo ""
  echo "${RED}❌ Commit BLOCKED — $ERRORS issue(s) found above.${NC}"
  echo "   Fix the issues and try again."
  exit 1
fi

echo "${GREEN}✅ Pre-commit checks passed.${NC}"
exit 0
