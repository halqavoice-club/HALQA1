# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
.next/
out/
dist/
build/

# Environment files — NEVER commit these
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
.env.docker
.env.docker.local
.env.docker.*.local

# Logs
logs/
*.log
npm-debug.log*
pm2-*.log

# Database
*.db
*.sqlite
backups/
# SQL backup files — should never be in source control
*backup*.sql
*_backup*.sql
halqa_db_*.sql

# Uploads (keep folder structure, ignore actual files)
backend/uploads/*
!backend/uploads/.gitkeep
backend/uploads/audio/*
!backend/uploads/audio/.gitkeep
backend/uploads/avatars/*
!backend/uploads/avatars/.gitkeep
backend/uploads/logos/*
!backend/uploads/logos/.gitkeep
backend/uploads/media/*
!backend/uploads/media/.gitkeep

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/settings.json
*.swp

# Prisma generated client (regenerated by `prisma generate`)
# NOTE: migrations/ is intentionally NOT ignored — they must be committed!
backend/node_modules/.prisma/

# SSL certificates
nginx/ssl/

# Temp files
*.tmp
*.bak
fix_mysql_exploit.reg

# ─── SECURITY / CLEANUP ADDITIONS (July 2026 audit) ─────────────────────────

# APK binaries — build artifacts should never be in source control.
# Use EAS Build or a CI artifact store instead.
*.apk
*.aab

# Backend log files — these are runtime outputs that may contain
# user IDs, IP addresses, error traces, and other sensitive data.
# Logs are kept in Docker volumes or a log aggregation service (Datadog, Loki).
backend/logs/*.log
backend/logs/combined*.log
backend/logs/error*.log

# Mobile build cache and EAS artifacts
mobile/.expo/
mobile/android/build/
mobile/ios/build/
mobile/dist/

# Coverage reports
coverage/
.nyc_output/

# Test artifacts
*.test.result
login_test.json

# Python bytecode (from root utility scripts)
__pycache__/
*.pyc
*.pyo

# ─── BUILD ARTIFACTS ─────────────────────────────────────────────────────────

# TypeScript incremental build cache — regenerated on every build
frontend/tsconfig.tsbuildinfo

# Lint output artifacts
frontend/lint-output.txt

# SSL certificates — should be provisioned by the server, not committed
frontend/certificates/

# Windows shortcuts
*.lnk

# Jest cache directories
mobile/.jest/
.jest/

# Demo seed scripts — contain hardcoded credentials, never for production
backend/prisma/seed-demo-accounts.js

# Browser-downloaded duplicate service worker files
frontend/public/sw\ (1).js
frontend/public/sw\ (*).js

# Temporary Google Drive upload cache
.tmp.driveupload/
.tmp.drivedownload/

# Local dev artifacts — never commit
frontend/.expo/
mobile/mobile-tsc-output.txt
mobile/_*.js
backend/test-join.js

# ─── V1-01 ADDITIONS ─────────────────────────────────────────────────────────

# Patch files — working-tree diff exports are development artifacts, not source.
# These may contain uncommitted code changes. Store them outside the repo or in
# a secure artifact store. Never commit a patch file to source control.
*.patch

# CI diagnostic and troubleshooting scripts — not part of the shipped product
ci-integration-logs.txt
backend/integration-test-output.txt

# Root-level audit scan scripts
_audit_scan.js
