# ─── HALQA .gitattributes ─────────────────────────────────────────────────────
# Normalizes line endings across Windows/Linux/Mac to prevent CRLF/LF warnings.
# All text files are stored as LF in the repo, converted on checkout for Windows.

# Default: normalize line endings for all text files
* text=auto

# Explicitly mark source code as text (LF in repo)
*.js      text eol=lf
*.jsx     text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.env     text eol=lf
*.sh      text eol=lf
*.sql     text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.prisma  text eol=lf
*.toml    text eol=lf
*.txt     text eol=lf
*.gitignore text eol=lf

# Shell scripts must have LF (not CRLF) to be executable on Linux/Mac/CI
scripts/git-hooks/pre-commit text eol=lf
scripts/git-hooks/pre-push   text eol=lf
deploy.sh                    text eol=lf
*.sh                         text eol=lf

# Windows batch files should keep CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Binary files — never convert
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.eot     binary
*.otf     binary
*.pdf     binary
*.zip     binary
*.gz      binary
*.tar     binary
*.apk     binary
*.aab     binary
*.ipa     binary
