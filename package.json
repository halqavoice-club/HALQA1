{
  "name": "halqa-shared",
  "version": "1.0.0",
  "private": true,
  "description": "Shared layout engine and test utilities for HALQA (platform-agnostic, no React deps)",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.5",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
