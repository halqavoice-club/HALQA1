// ─── LEADERBOARD CACHE TABLES ─────────────────────────────────────────────────────
// Phase C-7: Pre-computed leaderboards for performance
// Additive: All tables are NEW — zero changes to existing models above.

model GlobalLeaderboard {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation("GlobalLeaderboard", fields: [userId], references: [id], onDelete: Cascade)
  totalCoins      Int      @default(0)
  totalDiamonds   Int      @default(0)
  totalGifts      Int      @default(0)
  totalPosts      Int      @default(0)
  totalFollowers  Int      @default(0)
  rank            Int      @default(0)
  previousRank    Int?
  period          String   @default("ALL_TIME") // ALL_TIME, WEEKLY, MONTHLY
  updatedAt       DateTime @updatedAt

  @@index([rank])
  @@index([period])
  @@index([period, rank])    // leaderboard top-N by period
  @@map("global_leaderboard")
}

model SchoolLeaderboard {
  id              String   @id @default(uuid())
  schoolId        String
  userId          String
  user            User     @relation("SchoolLeaderboard", fields: [userId], references: [id], onDelete: Cascade)
  totalCoins      Int      @default(0)
  totalDiamonds   Int      @default(0)
  totalGifts      Int      @default(0)
  totalPosts      Int      @default(0)
  rank            Int      @default(0)
  previousRank    Int?
  period          String   @default("ALL_TIME")
  updatedAt       DateTime @updatedAt

  @@unique([schoolId, userId, period])
  @@index([schoolId])
  @@index([rank])
  @@index([period])
  @@map("school_leaderboard")
}

// ─── SEARCH OPTIMIZATION TABLES ───────────────────────────────────────────────────
// Phase C-8: Full-text search optimization tables
// Additive: All tables are NEW — zero changes to existing models above.

model SearchIndex {
  id              String   @id @default(uuid())
  entityType      String   // user, post, community, product
  entityId        String
  title           String
  content         String?  @db.Text
  tags            Json?    // array of tags
  schoolId        String?
  userId          String?
  popularity      Float    @default(0)
  lastIndexedAt   DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([entityType, entityId])
  @@index([entityType])
  @@index([schoolId])
  @@index([userId])
  @@index([popularity])
  @@map("search_index")
}

model TrendingHashtag {
  id              String   @id @default(uuid())
  hashtag         String   @unique
  count           Int      @default(0)
  rank            Int      @default(0)
  previousRank    Int?
  period          String   @default("HOURLY") // HOURLY, DAILY, WEEKLY
  updatedAt       DateTime @updatedAt

  @@index([rank])
  @@index([period])
  @@map("trending_hashtags")
}

// ─── BACKUP METADATA ─────────────────────────────────────────────────────────────
// Phase C-9: Backup tracking and metadata
// Additive: All tables are NEW — zero changes to existing models above.

model BackupMetadata {
  id              String   @id @default(uuid())
  backupType      String   // FULL, INCREMENTAL, DIFFERENTIAL
  backupMethod    String   // MANUAL, AUTOMATED, SCHEDULED
  fileName        String
  fileSize        BigInt
  filePath        String
  checksum        String   @db.VarChar(64)
  status          String   @default("COMPLETED") // PENDING, COMPLETED, FAILED
  startedAt       DateTime
  completedAt     DateTime?
  retentionDays   Int      @default(30)
  createdBy       String?
  notes           String?  @db.Text
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([backupType])
  @@index([status])
  @@index([startedAt])
  @@map("backup_metadata")
}

// ─── SESSION MANAGEMENT ───────────────────────────────────────────────────────
// Tracks per-device sessions for each user. Used by session.middleware.js
// to enforce session limits and allow users to view / terminate sessions.

model Session {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceName          String?   @db.VarChar(255) // e.g. "Windows - Chrome"
  deviceType          String?   @db.VarChar(50)  // desktop | mobile | tablet
  deviceFingerprint   String?   @db.VarChar(64)
  ipAddress           String?   @db.VarChar(45)
  userAgent           String?   @db.Text
  isActive            Boolean   @default(true)
  lastSeenAt          DateTime  @default(now())
  terminatedAt        DateTime?
  terminationReason   String?   @db.VarChar(50) // SESSION_LIMIT | USER_TERMINATED | USER_TERMINATED_ALL
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([userId])
  @@index([userId, isActive])
  @@index([deviceFingerprint])
  @@index([lastSeenAt, isActive])   // session cleanup + limit enforcement
  @@map("sessions")
}

// ─── WEBHOOK SYSTEM ───────────────────────────────────────────────────────────
// Manages webhook endpoints for event-driven integrations.

model Webhook {
  id          String   @id @default(uuid())
  url         String
  events      String
  secret      String?  @db.VarChar(255)
  headers     Json?
  description String?  @db.Text
  userId      String?
  schoolId    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries  WebhookDelivery[]

  @@index([userId])
  @@index([schoolId])
  @@map("webhooks")
}

model WebhookDelivery {
  id          String   @id @default(uuid())
  webhookId   String
  deliveryId  String
  event       String
  success     Boolean
  error       String?  @db.Text
  attempt     Int      @default(1)
  timestamp   DateTime @default(now())

  webhook     Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([timestamp])
  @@map("webhook_deliveries")
}

// ─── JOB SCHEDULER ─────────────────────────────────────────────────────────────
// Manages scheduled jobs and their execution history.

model ScheduledJob {
  id          String   @id @default(uuid())
  name        String   @unique
  type        String   @db.VarChar(50)
  schedule    String   @db.VarChar(100)
  timezone    String?  @db.VarChar(50)
  isActive    Boolean  @default(true)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  executions  JobExecution[]

  @@map("scheduled_jobs")
}

model JobExecution {
  id          String   @id @default(uuid())
  jobId       String
  name        String
  status      String   @db.VarChar(50)
  startedAt   DateTime @default(now())
  completedAt DateTime?
  error       String?  @db.Text

  job         ScheduledJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([status])
  @@map("job_executions")
}

// ─── IMPROVED AUDIT LOG ───────────────────────────────────────────────────────────
// Phase C-10: Enhanced audit log with additional fields
// Additive: New fields added to existing AuditLog model (backward compatible)

// Note: AuditLog model already exists above. The following fields are conceptually added:
// - sessionId: String? (for tracking session-based actions)
// - requestMethod: String? (HTTP method for API calls)
// - requestPath: String? (API endpoint path)
// - responseStatus: Int? (HTTP response code)
// - durationMs: Int? (request duration in milliseconds)
// These would be added via migration without breaking existing data.

// ─── PAYOUT REQUESTS ─────────────────────────────────────────────────────────
// Hosts request diamond-to-cash withdrawals via this model.
// Flow: PENDING → APPROVED → PROCESSING → COMPLETED | REJECTED | CANCELLED
// On reject/cancel: diamonds are refunded to the user's wallet.

model PayoutRequest {
  id             String    @id @default(uuid())
  userId         String
  diamonds       Int                          // diamonds requested for withdrawal
  usdAmount      Float                        // USD value (diamonds × 0.005)
  method         String    @db.VarChar(30)    // 'bank_transfer' | 'paypal' | 'stripe'
  accountDetails String    @db.Text           // JSON: method-specific payout details
  status         String    @default("PENDING") @db.VarChar(20)
  adminNote      String?   @db.VarChar(500)
  transactionRef String?   @db.VarChar(200)  // external payment reference
  processedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation("UserPayouts", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("payout_requests")
}

// ─── PK (PLAYER vs PLAYER) BATTLE SYSTEM ────────────────────────────────────
// ADDITIVE ONLY — zero changes to existing tables.
// All new PK tables use pk_ prefix. No existing model is modified.
// GiftTransaction.roomType already supports 'pk' as a value (checked in gift controller).
// RoomGiftLeaderboard.roomType already supports 'pk' as a value.

// ─── PK ENUMS ────────────────────────────────────────────────────────────────

enum PKMatchType {
  ONE_V_ONE       // 1v1 host battle
  ROOM_V_ROOM     // two rooms compete
  TEAM_V_TEAM     // team battle (2v2, 3v3, 5v5)
  CLUB_V_CLUB     // club challenge
  TOURNAMENT      // tournament bracket match
}

enum PKState {
  IDLE
  MATCHMAKING
  INVITED
  PENDING_ACCEPTANCE
  ACCEPTED
  PREPARING
  COUNTDOWN
  LIVE
  PAUSED
  FINISHING
  COMPLETED
  CANCELLED
  ABORTED
  DISPUTED
}

enum PKInvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum PKRank {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
  MASTER
  GRANDMASTER
}

enum PKSeasonStatus {
  UPCOMING
  ACTIVE
  ENDED
}

enum PKTournamentStatus {
  DRAFT
  REGISTRATION
  SEEDING
  ACTIVE
  COMPLETED
  CANCELLED
}

// ─── PK SEASON ────────────────────────────────────────────────────────────────
// Seasons define ranking periods. All rating changes are scoped to a season.

model PKSeason {
  id          String         @id @default(uuid())
  name        String         @db.VarChar(120)
  startDate   DateTime
  endDate     DateTime
  status      PKSeasonStatus @default(UPCOMING)
  description String?        @db.Text
  rules       Json?          // configurable scoring rules
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  matches     PKMatch[]
  ranks       PKRank_[]
  leaderboard PKLeaderboardEntry[]

  @@index([status])
  @@index([startDate])
  @@map("pk_seasons")
}

// ─── PK CONFIGURATION ─────────────────────────────────────────────────────────
// Single-row configuration table for platform-wide PK settings.
// Loaded on startup, cached in Redis.

model PKConfig {
  id                       String   @id @default(uuid())
  // Matchmaking
  matchmakingEnabled        Boolean  @default(true)
  maxRatingDiffInitial      Int      @default(50)
  maxRatingDiffExpand       Int      @default(100)   // after 10s
  maxRatingDiffFinal        Int      @default(200)   // after 20s
  matchmakingExpandInterval Int      @default(10)    // seconds
  // Match defaults
  defaultDurationSeconds    Int      @default(300)   // 5 minutes
  minDurationSeconds        Int      @default(60)
  maxDurationSeconds        Int      @default(600)
  countdownSeconds          Int      @default(5)
  // Scoring
  platformCutPercent        Int      @default(0)     // PK uses gift engine — no extra cut
  comboThresholds           Json     // [5, 10, 20, 50, 100]
  comebackThresholdPercent  Int      @default(30)    // % behind to enable comeback
  comebackMultiplier        Float    @default(1.5)
  audienceVoteWeight        Float    @default(0.1)   // votes count as 10% of final score
  // Leaderboard
  leaderboardCacheTtl       Int      @default(300)   // seconds
  // Feature flags
  pkEnabled                 Boolean  @default(true)
  tournamentEnabled         Boolean  @default(true)
  rankingEnabled            Boolean  @default(true)
  votingEnabled             Boolean  @default(true)
  teamEnabled               Boolean  @default(true)
  clubEnabled               Boolean  @default(true)
  // Anti-cheat
  maxGiftVelocityPerMinute  Int      @default(20)
  suspiciousRatingThreshold Float    @default(0.9)   // win rate above this triggers review
  minMatchesForRating       Int      @default(5)     // min matches before rating counts
  updatedAt                 DateTime @updatedAt

  @@map("pk_config")
}

// ─── PK MATCH ─────────────────────────────────────────────────────────────────
// Central match record. All other PK tables reference this via pkMatchId.

model PKMatch {
  id              String      @id @default(uuid())
  type            PKMatchType @default(ONE_V_ONE)
  state           PKState     @default(IDLE)
  seasonId        String?
  season          PKSeason?   @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  tournamentId    String?
  tournament      PKTournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  tournamentRound Int?
  // Room context — null for standalone PK, non-null for room-linked PK
  roomIdA         String?     // voice room ID for side A (no FK — roomType determines table)
  roomIdB         String?     // voice room ID for side B
  roomTypeA       String      @default("voice")  // voice | live_class
  roomTypeB       String      @default("voice")
  // Timing
  durationSeconds Int         @default(300)
  countdownSeconds Int        @default(5)
  scheduledAt     DateTime?
  startedAt       DateTime?
  endedAt         DateTime?
  pausedAt        DateTime?
  pausedDuration  Int         @default(0)  // accumulated pause time in seconds
  // Result
  winnerId        String?     // userId of winner (null if draw)
  winnerSide      String?     // 'A' | 'B' | 'DRAW'
  scoreA          Int         @default(0)
  scoreB          Int         @default(0)
  giftScoreA      Int         @default(0)  // raw gift value (no bonuses)
  giftScoreB      Int         @default(0)
  bonusScoreA     Int         @default(0)  // combo + comeback + vote bonus
  bonusScoreB     Int         @default(0)
  voteScoreA      Int         @default(0)  // audience votes for side A
  voteScoreB      Int         @default(0)
  peakComboA      Int         @default(0)
  peakComboB      Int         @default(0)
  peakViewers     Int         @default(0)
  // Metadata
  isRematch       Boolean     @default(false)
  previousMatchId String?     // if rematch, links to prior match
  previousMatch   PKMatch?    @relation("PKRematch", fields: [previousMatchId], references: [id], onDelete: SetNull)
  rematches       PKMatch[]   @relation("PKRematch")
  // Admin
  endedByAdmin    Boolean     @default(false)
  adminNote       String?     @db.Text
  disputeReason   String?     @db.Text
  idempotencyKey  String      @unique
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  participants    PKParticipant[]
  teams           PKTeam[]
  gifts           PKGiftEvent[]
  votes           PKVote[]
  auditLogs       PKAuditLog[]
  history         PKHistory?

  @@index([state])
  @@index([seasonId])
  @@index([tournamentId])
  @@index([winnerId])
  @@index([createdAt])
  @@index([type, state])
  @@map("pk_matches")
}

// ─── PK PARTICIPANT ───────────────────────────────────────────────────────────
// One row per user per side (A or B) per match.
// For 1v1: two rows (sideA=true for one, sideA=false for the other).
// For team PK: multiple rows per side with teamId set.

model PKParticipant {
  id           String    @id @default(uuid())
  pkMatchId    String
  match        PKMatch   @relation(fields: [pkMatchId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation("PKUserParticipant", fields: [userId], references: [id], onDelete: Cascade)
  side         String    @db.VarChar(1)   // 'A' | 'B'
  role         String    @default("HOST") // HOST | CO_HOST | TEAM_CAPTAIN | TEAM_MEMBER
  teamId       String?   // non-null for team PK
  team         PKTeam?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  isActive     Boolean   @default(true)
  joinedAt     DateTime  @default(now())
  leftAt       DateTime?
  disconnectedAt DateTime?
  reconnectedAt  DateTime?
  // Per-participant scoring contribution
  giftScore    Int       @default(0)
  bonusScore   Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([pkMatchId, userId])
  @@index([pkMatchId])
  @@index([userId])
  @@index([side])
  @@map("pk_participants")
}

// ─── PK TEAM ──────────────────────────────────────────────────────────────────
// Used for team PK (2v2, 3v3, 5v5) and club PK.

model PKTeam {
  id         String          @id @default(uuid())
  pkMatchId  String
  match      PKMatch         @relation(fields: [pkMatchId], references: [id], onDelete: Cascade)
  side       String          @db.VarChar(1)  // 'A' | 'B'
  name       String          @db.VarChar(120)
  avatarUrl  String?         @db.VarChar(2048)
  captainId  String          // userId of team captain
  clubId     String?         // nullable — only set for club PK
  score      Int             @default(0)
  giftScore  Int             @default(0)
  bonusScore Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  members    PKParticipant[]

  @@index([pkMatchId])
  @@index([side])
  @@map("pk_teams")
}

// ─── PK INVITATION ────────────────────────────────────────────────────────────
// Friend/direct PK invitations.

model PKInvitation {
  id              String              @id @default(uuid())
  senderId        String
  receiverId      String
  pkMatchId       String?             // created after acceptance
  type            PKMatchType         @default(ONE_V_ONE)
  status          PKInvitationStatus  @default(PENDING)
  message         String?             @db.VarChar(280)
  durationSeconds Int                 @default(300)
  teamSize        Int                 @default(1)  // 1=1v1, 2=2v2 etc.
  expiresAt       DateTime
  acceptedAt      DateTime?
  rejectedAt      DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([senderId])
  @@index([receiverId])
  @@index([status])
  @@index([expiresAt])
  @@index([receiverId, status])   // pending invitations for a user
  @@map("pk_invitations")
}

// ─── PK GIFT EVENT ────────────────────────────────────────────────────────────
// Immutable record linking a verified GiftTransaction to a PK match.
// The gift engine remains the source of truth — this is a derived record only.
// A gift counts in PK scoring ONLY if a PKGiftEvent record exists for it.

model PKGiftEvent {
  id                String   @id @default(uuid())
  pkMatchId         String
  match             PKMatch  @relation(fields: [pkMatchId], references: [id], onDelete: Cascade)
  giftTransactionId String   @unique   // UNIQUE prevents double-counting
  side              String   @db.VarChar(1)  // 'A' | 'B' — which side benefits
  beneficiaryId     String   // userId who receives the score credit
  coinsSpent        Int      // copied from GiftTransaction (immutable snapshot)
  giftScore         Int      // base score (= coinsSpent)
  comboMultiplier   Float    @default(1.0)
  comboLevel        Int      @default(0)     // 0=none, 1=x5, 2=x10, etc.
  isComebackBonus   Boolean  @default(false)
  bonusScore        Int      @default(0)     // calculated bonus (not raw gift value)
  finalScore        Int      // giftScore + bonusScore
  processedAt       DateTime @default(now())
  createdAt         DateTime @default(now())

  @@index([pkMatchId])
  @@index([side])
  @@index([beneficiaryId])
  @@index([pkMatchId, side])
  @@map("pk_gift_events")
}

// ─── PK VOTE ──────────────────────────────────────────────────────────────────
// Audience votes for one side. Rate-limited at the API layer.

model PKVote {
  id        String   @id @default(uuid())
  pkMatchId String
  match     PKMatch  @relation(fields: [pkMatchId], references: [id], onDelete: Cascade)
  userId    String
  side      String   @db.VarChar(1)  // 'A' | 'B'
  createdAt DateTime @default(now())

  @@unique([pkMatchId, userId])  // one vote per user per match
  @@index([pkMatchId])
  @@index([userId])
  @@index([side])
  @@map("pk_votes")
}

// ─── PK MATCHMAKING QUEUE ENTRY ───────────────────────────────────────────────
// Persistent record of queue entry (primary state is in Redis, DB for audit).

model PKMatchmakingQueue {
  id              String   @id @default(uuid())
  userId          String   @unique  // one queue entry per user
  type            PKMatchType @default(ONE_V_ONE)
  preferredRating Int?
  preferredRegion String?  @db.VarChar(40)
  preferredLang   String?  @db.VarChar(10)
  durationSeconds Int      @default(300)
  teamSize        Int      @default(1)
  enteredAt       DateTime @default(now())
  matchedAt       DateTime?
  cancelledAt     DateTime?
  pkMatchId       String?  // set when matched

  @@index([type])
  @@index([enteredAt])
  @@map("pk_matchmaking_queue")
}

// ─── PK HISTORY ───────────────────────────────────────────────────────────────
// Permanent, immutable record created when a match completes.
// Never deleted. Never modified after creation.

model PKHistory {
  id              String   @id @default(uuid())
  pkMatchId       String   @unique
  match           PKMatch  @relation(fields: [pkMatchId], references: [id], onDelete: Restrict)
  type            PKMatchType
  winnerId        String?
  winnerSide      String?  @db.VarChar(1)
  loserSide       String?  @db.VarChar(1)
  scoreA          Int
  scoreB          Int
  giftScoreA      Int
  giftScoreB      Int
  voteScoreA      Int
  voteScoreB      Int
  peakComboA      Int
  peakComboB      Int
  peakViewers     Int
  durationSeconds Int
  seasonId        String?
  tournamentId    String?
  participantIds  Json     // array of userId strings
  sideAIds        Json     // array of userId strings for side A
  sideBIds        Json     // array of userId strings for side B
  teamAName       String?
  teamBName       String?
  totalGifts      Int      @default(0)
  totalCoins      Int      @default(0)
  wasDisputed     Boolean  @default(false)
  recordingUrl    String?  @db.VarChar(2048)
  createdAt       DateTime @default(now())

  @@index([winnerId])
  @@index([seasonId])
  @@index([tournamentId])
  @@index([createdAt])
  @@map("pk_history")
}

// ─── PK USER STATS ────────────────────────────────────────────────────────────
// Aggregate stats per user. Updated atomically after each match.

model PKUserStats {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation("PKUserStats", fields: [userId], references: [id], onDelete: Cascade)
  // Career stats
  totalPKs        Int      @default(0)
  wins            Int      @default(0)
  losses          Int      @default(0)
  draws           Int      @default(0)
  winRate         Float    @default(0.0)
  currentStreak   Int      @default(0)   // positive=wins, negative=losses
  bestStreak      Int      @default(0)
  totalScore      Int      @default(0)
  highestScore    Int      @default(0)
  totalGiftsSent  Int      @default(0)   // total coins sent during PK
  totalGiftsRecv  Int      @default(0)   // total coins received during PK
  avgScore        Float    @default(0.0)
  avgDuration     Float    @default(0.0) // seconds
  // Rating
  rating          Int      @default(1000) // ELO-style
  rank            PKRank   @default(BRONZE)
  peakRating      Int      @default(1000)
  peakRank        PKRank   @default(BRONZE)
  // Season
  seasonId        String?
  seasonWins      Int      @default(0)
  seasonLosses    Int      @default(0)
  seasonScore     Int      @default(0)
  seasonRating    Int      @default(1000)
  seasonRank      PKRank   @default(BRONZE)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([rating])
  @@index([rank])
  @@map("pk_user_stats")
}

// ─── PK RANK ──────────────────────────────────────────────────────────────────
// Per-season rank record — immutable after season closes.

model PKRank_ {
  id        String   @id @default(uuid())
  userId    String
  seasonId  String
  season    PKSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  rank      PKRank   @default(BRONZE)
  rating    Int      @default(1000)
  wins      Int      @default(0)
  losses    Int      @default(0)
  score     Int      @default(0)
  position  Int?     // leaderboard position at season end
  rewards   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, seasonId])
  @@index([seasonId])
  @@index([rating])
  @@index([rank])
  @@map("pk_ranks")
}

// ─── PK LEADERBOARD ENTRY ─────────────────────────────────────────────────────
// Cache-backed leaderboard. Rebuilt from PKUserStats + PKHistory.

model PKLeaderboardEntry {
  id       String   @id @default(uuid())
  scope    String   @db.VarChar(20)  // 'daily' | 'weekly' | 'monthly' | 'season' | 'all_time'
  period   String   @db.VarChar(30)  // e.g. '2026-08' for monthly, seasonId for season
  userId   String
  seasonId String?
  season   PKSeason? @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  rank     Int
  score    Int      @default(0)
  wins     Int      @default(0)
  rating   Int      @default(1000)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([scope, period, userId])
  @@index([scope, period, rank])
  @@index([userId])
  @@map("pk_leaderboard")
}

// ─── PK TOURNAMENT ────────────────────────────────────────────────────────────

model PKTournament {
  id                String               @id @default(uuid())
  name              String               @db.VarChar(120)
  description       String?              @db.Text
  status            PKTournamentStatus   @default(DRAFT)
  type              PKMatchType          @default(ONE_V_ONE)
  bracketType       String               @default("SINGLE_ELIMINATION") // SINGLE_ELIMINATION | ROUND_ROBIN
  maxParticipants   Int                  @default(16)
  registeredCount   Int                  @default(0)
  teamSize          Int                  @default(1)
  registrationStart DateTime
  registrationEnd   DateTime
  startDate         DateTime
  endDate           DateTime
  prizeDescription  String?              @db.Text
  rules             Json?
  createdBy         String               // admin userId
  cancelledAt       DateTime?
  cancelReason      String?              @db.Text
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  participants      PKTournamentParticipant[]
  matches           PKMatch[]

  @@index([status])
  @@index([startDate])
  @@map("pk_tournaments")
}

model PKTournamentParticipant {
  id             String       @id @default(uuid())
  tournamentId   String
  tournament     PKTournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId         String
  seed           Int?
  wins           Int          @default(0)
  losses         Int          @default(0)
  eliminated     Boolean      @default(false)
  eliminatedAt   DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([tournamentId, userId])
  @@index([tournamentId])
  @@index([userId])
  @@map("pk_tournament_participants")
}

// ─── PK ACHIEVEMENT ──────────────────────────────────────────────────────────

model PKAchievement {
  id           String   @id @default(uuid())
  key          String   @unique  // e.g. 'first_win', 'win_10', 'combo_king'
  name         String   @db.VarChar(120)
  description  String   @db.Text
  iconUrl      String?  @db.VarChar(2048)
  condition    Json     // server-evaluated condition definition
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  userAchievements PKUserAchievement[]

  @@index([isActive])
  @@map("pk_achievements")
}

model PKUserAchievement {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation("PKUserAchievement", fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   PKAchievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime      @default(now())
  pkMatchId     String?       // the match that triggered the unlock

  @@unique([userId, achievementId])
  @@index([userId])
  @@map("pk_user_achievements")
}

// ─── PK MISSION ───────────────────────────────────────────────────────────────

model PKMission {
  id           String   @id @default(uuid())
  key          String   @unique
  name         String   @db.VarChar(120)
  description  String   @db.Text
  type         String   @default("DAILY")  // DAILY | WEEKLY
  condition    Json     // server-evaluated condition
  reward       Json?    // reward definition
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  progress     PKMissionProgress[]

  @@index([type])
  @@index([isActive])
  @@map("pk_missions")
}

model PKMissionProgress {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation("PKMissionProgress", fields: [userId], references: [id], onDelete: Cascade)
  missionId  String
  mission    PKMission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  progress   Int       @default(0)
  target     Int
  completed  Boolean   @default(false)
  completedAt DateTime?
  periodStart DateTime  // day/week start
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, missionId, periodStart])
  @@index([userId])
  @@index([missionId])
  @@index([completed])
  @@map("pk_mission_progress")
}

// ─── PK AUDIT LOG ─────────────────────────────────────────────────────────────
// Every administrative action on a PK match is logged here.

model PKAuditLog {
  id          String   @id @default(uuid())
  pkMatchId   String
  match       PKMatch  @relation(fields: [pkMatchId], references: [id], onDelete: Cascade)
  adminId     String   // userId performing the action
  action      String   @db.VarChar(60)  // e.g. 'FORCE_END', 'PAUSE', 'CORRECT_SCORE'
  reason      String?  @db.Text
  beforeValue Json?
  afterValue  Json?
  createdAt   DateTime @default(now())

  @@index([pkMatchId])
  @@index([adminId])
  @@map("pk_audit_logs")
}

// ─── PK ANALYTICS EVENT ───────────────────────────────────────────────────────
// Structured event stream for the analytics pipeline. Batch-written asynchronously.

model PKAnalyticsEvent {
  id        String   @id @default(uuid())
  eventType String   @db.VarChar(60)  // PK_CREATED | PK_STARTED | PK_GIFT | PK_ENDED | etc.
  pkMatchId String?
  userId    String?
  side      String?  @db.VarChar(1)
  data      Json?
  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([pkMatchId])
  @@index([userId])
  @@index([createdAt])
  @@map("pk_analytics_events")
}

// ─── END PK SYSTEM ────────────────────────────────────────────────────────────
