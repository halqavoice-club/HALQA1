// ─── MARKETPLACE SYSTEM ───────────────────────────────────────────────────────────
// Phase C-4: School marketplace for books, uniforms, supplies
// Additive: All tables are NEW — zero changes to existing models above.

enum ProductCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Product {
  id              String           @id @default(uuid())
  schoolId        String?
  school          School?          @relation("MarketplaceProducts", fields: [schoolId], references: [id])
  sellerId        String
  seller          User             @relation("SellerProducts", fields: [sellerId], references: [id], onDelete: Cascade)
  title           String
  description     String?          @db.Text
  category        String           @default("OTHER") // BOOKS, UNIFORMS, SUPPLIES, ELECTRONICS, OTHER
  condition       ProductCondition @default(NEW)
  price           Decimal          @db.Decimal(10, 2)
  negotiable      Boolean          @default(false)
  images          Json?            // array of image URLs
  stock           Int              @default(1)
  viewCount       Int              @default(0)
  favoriteCount   Int              @default(0)
  soldCount       Int              @default(0)
  isActive        Boolean          @default(true)
  featured        Boolean          @default(false)
  expiresAt       DateTime?
  deletedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  orders          Order[]
  reviews         Review[]

  @@index([schoolId])
  @@index([sellerId])
  @@index([category])
  @@index([condition])
  @@index([isActive])
  @@index([createdAt])
  @@map("products")
}

model Order {
  id              String       @id @default(uuid())
  schoolId        String?
  school          School?      @relation("MarketplaceOrders", fields: [schoolId], references: [id])
  productId       String
  product         Product      @relation(fields: [productId], references: [id])
  buyerId         String
  buyer           User         @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId        String
  seller          User         @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Cascade)
  quantity        Int          @default(1)
  totalPrice      Decimal      @db.Decimal(10, 2)
  status          OrderStatus  @default(PENDING)
  shippingAddress Json?
  notes           String?      @db.Text
  confirmedAt     DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  refundedAt      DateTime?
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  reviews         Review[]

  @@index([schoolId])
  @@index([productId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model Review {
  id              String   @id @default(uuid())
  productId       String?
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  orderId         String?
  order           Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  reviewerId      String
  reviewer        User     @relation("UserReviews", fields: [reviewerId], references: [id], onDelete: Cascade)
  sellerId        String
  seller          User     @relation("SellerReviews", fields: [sellerId], references: [id], onDelete: Cascade)
  rating          Int      // 1-5 stars
  title           String?
  body            String?  @db.Text
  images          Json?    // array of image URLs
  isVerified      Boolean  @default(false) // verified purchase
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([productId])
  @@index([orderId])
  @@index([reviewerId])
  @@index([sellerId])
  @@index([rating])
  @@map("reviews")
}

// ─── TRANSPORT SYSTEM ─────────────────────────────────────────────────────────────
// Phase C-5: School bus management with routes, stops, and drivers
// Additive: All tables are NEW — zero changes to existing models above.

enum BusStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  OUT_OF_SERVICE
}

enum DriverStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  SUSPENDED
}

model SchoolBus {
  id              String     @id @default(uuid())
  schoolId        String
  school          School     @relation("SchoolBuses", fields: [schoolId], references: [id])
  plateNumber     String     @unique
  busNumber       String     @unique
  capacity        Int        @default(40)
  make            String?
  model           String?
  year            Int?
  color           String?
  fuelType        String?    @default("DIESEL")
  status          BusStatus  @default(ACTIVE)
  insuranceExpiry DateTime?
  lastServiceAt   DateTime?
  nextServiceAt   DateTime?
  notes           String?    @db.Text
  deletedAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  routes          BusRoute[]
  assignments     BusAssignment[]

  @@index([schoolId])
  @@index([status])
  @@map("school_buses")
}

model BusRoute {
  id              String   @id @default(uuid())
  schoolId        String
  school          School   @relation("BusRoutes", fields: [schoolId], references: [id])
  busId           String
  bus             SchoolBus @relation(fields: [busId], references: [id], onDelete: Cascade)
  name            String
  description     String?  @db.Text
  routeNumber     String?
  startTime       String   // HH:MM format
  endTime         String   // HH:MM format
  distanceKm      Float?
  durationMin     Int?
  isActive        Boolean  @default(true)
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  stops           BusStop[]
  assignments     BusAssignment[]

  @@index([schoolId])
  @@index([busId])
  @@index([isActive])
  @@map("bus_routes")
}

model BusStop {
  id              String   @id @default(uuid())
  routeId         String
  route           BusRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  name            String
  address         String?  @db.Text
  latitude        Float?
  longitude       Float?
  sequence        Int      @default(0)
  estimatedTime   String?  // HH:MM format from start
  isActive        Boolean  @default(true)
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assignments     BusAssignment[]

  @@index([routeId])
  @@index([sequence])
  @@map("bus_stops")
}

model Driver {
  id              String       @id @default(uuid())
  schoolId        String
  school          School       @relation("Drivers", fields: [schoolId], references: [id])
  userId          String?      @unique
  user            User?        @relation("DriverProfile", fields: [userId], references: [id], onDelete: SetNull)
  firstName       String
  lastName        String
  phone           String
  licenseNumber   String       @unique
  licenseExpiry   DateTime?
  address         String?      @db.Text
  emergencyContact Json?
  status          DriverStatus @default(ACTIVE)
  hiredAt         DateTime?
  notes           String?      @db.Text
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  assignments     BusAssignment[]

  @@index([schoolId])
  @@index([userId])
  @@index([status])
  @@map("drivers")
}

model BusAssignment {
  id              String   @id @default(uuid())
  schoolId        String
  busId           String
  bus             SchoolBus @relation(fields: [busId], references: [id], onDelete: Cascade)
  routeId         String
  route           BusRoute  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stopId          String?
  stop            BusStop?  @relation(fields: [stopId], references: [id], onDelete: SetNull)
  driverId        String
  driver          Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  studentId       String
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  pickupTime      String   // HH:MM format
  dropoffTime     String   // HH:MM format
  isMorning       Boolean  @default(true)
  isAfternoon     Boolean  @default(true)
  isActive        Boolean  @default(true)
  effectiveFrom   DateTime @default(now())
  effectiveTo     DateTime?
  notes           String?  @db.Text
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([studentId, isMorning, effectiveFrom])
  @@index([schoolId])
  @@index([busId])
  @@index([routeId])
  @@index([driverId])
  @@index([studentId])
  @@index([isActive])
  @@map("bus_assignments")
}

