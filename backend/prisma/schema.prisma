  schoolId        String
  date            DateTime @db.Date
  studentCount    Int      @default(0)
  teacherCount    Int      @default(0)
  classCount      Int      @default(0)
  attendanceRate  Float?
  averageGrade    Float?
  behaviorScore   Float?
  totalPosts      Int      @default(0)
  totalMessages   Int      @default(0)
  totalGifts      Int      @default(0)
  totalCoins      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([schoolId, date])
  @@index([schoolId])
  @@index([date])
  @@map("daily_school_stats")
}

model DailyUserStats {
  id              String   @id @default(uuid())
  userId          String
  date            DateTime @db.Date
  loginCount      Int      @default(0)
  postsCreated    Int      @default(0)
  commentsCreated Int      @default(0)
  likesGiven      Int      @default(0)
  likesReceived   Int      @default(0)
