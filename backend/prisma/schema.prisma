model TrendingHashtag {
  id              String   @id @default(uuid())
  hashtag         String   @unique
  count           Int      @default(0)
  rank            Int      @default(0)
  previousRank    Int?
  period          String   @default("HOURLY") // HOURLY, DAILY, WEEKLY
  updatedAt       DateTime @updatedAt

  @@index([rank])
  @@index([period])
  @@map("trending_hashtags")
}

// ─── BACKUP METADATA ─────────────────────────────────────────────────────────────
// Phase C-9: Backup tracking and metadata
// Additive: All tables are NEW — zero changes to existing models above.

model BackupMetadata {
  id              String   @id @default(uuid())
  backupType      String   // FULL, INCREMENTAL, DIFFERENTIAL
  backupMethod    String   // MANUAL, AUTOMATED, SCHEDULED
  fileName        String
  fileSize        BigInt
  filePath        String
  checksum        String   @db.VarChar(64)
  status          String   @default("COMPLETED") // PENDING, COMPLETED, FAILED
  startedAt       DateTime
  completedAt     DateTime?
  retentionDays   Int      @default(30)
  createdBy       String?
  notes           String?  @db.Text
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([backupType])
  @@index([status])
  @@index([startedAt])
  @@map("backup_metadata")
}

// ─── SESSION MANAGEMENT ───────────────────────────────────────────────────────
// Tracks per-device sessions for each user. Used by session.middleware.js
// to enforce session limits and allow users to view / terminate sessions.

model Session {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceName          String?   @db.VarChar(255) // e.g. "Windows - Chrome"
  deviceType          String?   @db.VarChar(50)  // desktop | mobile | tablet
  deviceFingerprint   String?   @db.VarChar(64)
  ipAddress           String?   @db.VarChar(45)
  userAgent           String?   @db.Text
  isActive            Boolean   @default(true)
  lastSeenAt          DateTime  @default(now())
  terminatedAt        DateTime?
  terminationReason   String?   @db.VarChar(50) // SESSION_LIMIT | USER_TERMINATED | USER_TERMINATED_ALL
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([userId])
  @@index([userId, isActive])
  @@index([deviceFingerprint])
  @@map("sessions")
}

// ─── WEBHOOK SYSTEM ───────────────────────────────────────────────────────────
// Manages webhook endpoints for event-driven integrations.

model Webhook {
  id          String   @id @default(uuid())
  url         String
  events      String
  secret      String?  @db.VarChar(255)
  headers     Json?
  description String?  @db.Text
  userId      String?
  schoolId    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries  WebhookDelivery[]

  @@index([userId])
  @@index([schoolId])
  @@map("webhooks")
}

model WebhookDelivery {
  id          String   @id @default(uuid())
  webhookId   String
  deliveryId  String
  event       String
  success     Boolean
  error       String?  @db.Text
  attempt     Int      @default(1)
  timestamp   DateTime @default(now())

  webhook     Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([timestamp])
  @@map("webhook_deliveries")
}

// ─── JOB SCHEDULER ─────────────────────────────────────────────────────────────
// Manages scheduled jobs and their execution history.

model ScheduledJob {
  id          String   @id @default(uuid())
  name        String   @unique
  type        String   @db.VarChar(50)
  schedule    String   @db.VarChar(100)
  timezone    String?  @db.VarChar(50)
  isActive    Boolean  @default(true)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  executions  JobExecution[]

  @@map("scheduled_jobs")
}

model JobExecution {
  id          String   @id @default(uuid())
  jobId       String
  name        String
  status      String   @db.VarChar(50)
  startedAt   DateTime @default(now())
  completedAt DateTime?
  error       String?  @db.Text

  job         ScheduledJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([status])
  @@map("job_executions")
}

// ─── IMPROVED AUDIT LOG ───────────────────────────────────────────────────────────
// Phase C-10: Enhanced audit log with additional fields
// Additive: New fields added to existing AuditLog model (backward compatible)

// Note: AuditLog model already exists above. The following fields are conceptually added:
// - sessionId: String? (for tracking session-based actions)
// - requestMethod: String? (HTTP method for API calls)
// - requestPath: String? (API endpoint path)
// - responseStatus: Int? (HTTP response code)
// - durationMs: Int? (request duration in milliseconds)
// These would be added via migration without breaking existing data.

// ─── PAYOUT REQUESTS ─────────────────────────────────────────────────────────
// Hosts request diamond-to-cash withdrawals via this model.
// Flow: PENDING → APPROVED → PROCESSING → COMPLETED | REJECTED | CANCELLED
// On reject/cancel: diamonds are refunded to the user's wallet.

model PayoutRequest {
  id             String    @id @default(uuid())
  userId         String
  diamonds       Int                          // diamonds requested for withdrawal
  usdAmount      Float                        // USD value (diamonds × 0.005)
  method         String    @db.VarChar(30)    // 'bank_transfer' | 'paypal' | 'stripe'
  accountDetails String    @db.Text           // JSON: method-specific payout details
  status         String    @default("PENDING") @db.VarChar(20)
  adminNote      String?   @db.VarChar(500)
  transactionRef String?   @db.VarChar(200)  // external payment reference
  processedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation("UserPayouts", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("payout_requests")
}
