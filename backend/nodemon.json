{
  "watch": ["src", "prisma/schema.prisma"],
  "ext": "js,json,prisma",
  "exec": "node --max-old-space-size=512 --expose-gc",
  "ignore": [
    "node_modules/**",
    "logs/**",
    "uploads/**",
    "prisma/migrations/**",
    "node_modules/.prisma/**",
    "node_modules/@prisma/client/**"
  ],
  "delay": 500,
  "env": {
    "NODE_ENV": "development"
  },
  "events": {
    "restart": "echo '🔄 Server restarted'"
  }
}
