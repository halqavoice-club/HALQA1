{
  "name": "halqa-management-backend",
  "version": "1.0.0",
  "description": "Halqa Management System - Enterprise School ERP Backend",
  "main": "src/app.js",
  "scripts": {
    "start": "node --max-old-space-size=512 --expose-gc src/app.js",
    "dev": "npx nodemon --config nodemon.json src/app.js",
    "test": "jest --runInBand --forceExit",
    "test:unit": "jest --runInBand --forceExit --testPathIgnorePatterns=integration --testPathIgnorePatterns=real-db --testPathIgnorePatterns=phase-c --testPathIgnorePatterns=google-auth --testPathIgnorePatterns=bug-003",
    "test:group:social": "jest --runInBand --forceExit --testPathIgnorePatterns=integration --testPathIgnorePatterns=real-db --testPathIgnorePatterns=phase-c --testPathIgnorePatterns=google-auth --testPathIgnorePatterns=bug-003 --testPathPattern=\"social|post|feed|comment|reaction|follow|friend|explore|story|report|community.socket|phase3|phase4|phase5|phase6|phase7|task2|task6|bug.005|sprint11\" --no-coverage",
    "test:group:voice": "jest --runInBand --forceExit --testPathIgnorePatterns=integration --testPathIgnorePatterns=real-db --testPathIgnorePatterns=phase-c --testPathIgnorePatterns=google-auth --testPathIgnorePatterns=bug-003 --testPathPattern=\"voice|ph19|ph24c|pk|vc.sync|sprint12|sprint17|sprint18|sprint19\" --no-coverage",
    "test:group:live-class": "jest --runInBand --forceExit --testPathIgnorePatterns=integration --testPathIgnorePatterns=real-db --testPathIgnorePatterns=phase-c --testPathIgnorePatterns=google-auth --testPathIgnorePatterns=bug-003 --testPathPattern=\"live.class|livekit|maxspeaker|public.stream|ph24a|sprint14|sprint16\" --no-coverage",
    "test:group:auth": "jest --runInBand --forceExit --testPathIgnorePatterns=integration --testPathIgnorePatterns=real-db --testPathIgnorePatterns=phase-c --testPathIgnorePatterns=google-auth --testPathIgnorePatterns=bug-003 --testPathPattern=\"super.admin|architecture|p0.security|p1.security|p2.security|p3.security|erp.remediation|school.auth|school.membership|platform.admin|phase24j|idempotency|health|rateLimiter|session|privilege|ui.separation|auth\\.test|sprint7|sprint8|sprint9|sprint10|graphql|validation|encryption|internal.provisioning|phase2|phase4b|payout|wallet|gift|economy|creator|stripe\" --no-coverage",
    "test:group:realtime": "jest --runInBand --forceExit --testPathIgnorePatterns=integration --testPathIgnorePatterns=real-db --testPathIgnorePatterns=phase-c --testPathIgnorePatterns=google-auth --testPathIgnorePatterns=bug-003 --testPathPattern=\"socket.auth.vuln|alerting|cache|circuitBreaker|tracing|db.hardening|production.hardening|apiVersion|errors\" --no-coverage",
    "test:integration": "jest --runInBand --forceExit --testPathIgnorePatterns=node_modules --testPathPattern=integration",
    "test:coverage": "jest --runInBand --forceExit --coverage --testPathIgnorePatterns='integration'",
    "check": "node src/prisma/check-setup.js",
    "setup": "npx prisma generate && npx prisma migrate dev --name init && node src/prisma/seed.js",
    "secrets": "node src/prisma/generate-secrets.js",
    "fix-mysql": "powershell -ExecutionPolicy Bypass -File fix-mysql.ps1",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:migrate:prod": "npx prisma migrate deploy",
    "prisma:studio": "npx prisma studio",
    "seed": "node src/prisma/seed.js",
    "seed:gifts": "node src/prisma/seed-gifts.js",
    "fix-voice-db": "node src/prisma/fix-voice-db.js",
    "check-columns": "node src/prisma/check-columns.js",
    "test-runtime": "node src/prisma/runtime-test.js",
    "backup": "node src/prisma/backup.js",
    "test:r2": "node test-r2.js",
    "migrate:r2": "node src/prisma/migrate-to-r2.js",
    "migrate:r2:dry": "node src/prisma/migrate-to-r2.js --dry-run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/s3-request-presigner": "3.1149.0",
    "@graphql-tools/schema": "^10.1.3",
    "@opentelemetry/auto-instrumentations-node": "0.81.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@prisma/client": "7.10.0",
    "@socket.io/redis-adapter": "8.3.0",
    "@apollo/server": "5.5.1",
    "@as-integrations/express4": "1.1.2",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.12",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^18.0.7",
    "engine.io": "^6.6.11",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.0.1",
    "file-type": "22.1.1",
    "firebase-admin": "14.5.0",
    "google-auth-library": "11.2.0",
    "graphql": "^17.0.2",
    "graphql-subscriptions": "^3.0.0",
    "graphql-ws": "^6.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "livekit-server-sdk": "^2.19.1",
    "morgan": "^1.12.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.1.1",
    "otplib": "^13.5.0",
    "pdfkit": "^0.20.2",
    "prisma": "7.10.0",
    "prom-client": "^15.1.3",
    "socket.io": "4.8.4",
    "socket.io-adapter": "^2.5.8",
    "socket.io-parser": "^4.2.7",
    "stripe": "^23.0.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.0",
    "uuid": "11.1.1",
    "winston": "^3.11.0",
    "ws": "^8.22.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "jest": "30.5.2",
    "nodemon": "^3.0.3",
    "socket.io-client": "^4.8.4",
    "supertest": "7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/src/tests/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/src/tests/integration/"
    ],
    "testTimeout": 30000,
    "clearMocks": true,
    "restoreMocks": false,
    "setupFiles": [
      "./jest.setup.js"
    ],
    "moduleNameMapper": {
      "@opentelemetry/instrumentation-prisma": "<rootDir>/src/tests/__mocks__/otel-prisma.js",
      "@opentelemetry/instrumentation-redis": "<rootDir>/src/tests/__mocks__/otel-redis.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(livekit-server-sdk|@livekit)/)"
    ]
  }
}
