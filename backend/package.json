{
  "name": "halqa-management-backend",
  "version": "1.0.0",
  "description": "Halqa Management System - Enterprise School ERP Backend",
  "main": "src/app.js",
  "scripts": {
    "start": "node --max-old-space-size=512 --expose-gc src/app.js",
    "dev": "npx nodemon --config nodemon.json src/app.js",
    "test": "node test-safety/run-jest.js",
    "test:unit": "node test-safety/run-jest.js",
    "test:group:social": "node test-safety/run-jest.js --group=social",
    "test:group:voice": "node test-safety/run-jest.js --group=voice",
    "test:group:live-class": "node test-safety/run-jest.js --group=live-class",
    "test:group:auth": "node test-safety/run-jest.js --group=auth",
    "test:group:realtime": "node test-safety/run-jest.js --group=realtime",
    "test:integration": "node test-safety/disabled-integration.js",
    "test:coverage": "node test-safety/run-jest.js --coverage",
    "check": "node src/prisma/check-setup.js",
    "setup": "npx prisma generate && npx prisma migrate dev --name init && node src/prisma/seed.js",
    "secrets": "node src/prisma/generate-secrets.js",
    "fix-mysql": "powershell -ExecutionPolicy Bypass -File fix-mysql.ps1",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:migrate:prod": "npx prisma migrate deploy",
    "prisma:studio": "npx prisma studio",
    "seed": "node src/prisma/seed.js",
    "seed:gifts": "node src/prisma/seed-gifts.js",
    "fix-voice-db": "node src/prisma/fix-voice-db.js",
    "check-columns": "node src/prisma/check-columns.js",
    "test-runtime": "node -e \"console.error('Disabled in Phase 3B-1: this command connects to a database.'); process.exit(1)\"",
    "backup": "node src/prisma/backup.js",
    "test:r2": "node -e \"console.error('Disabled in Phase 3B-1: this command mutates external R2 storage.'); process.exit(1)\"",
    "migrate:r2": "node src/prisma/migrate-to-r2.js",
    "migrate:r2:dry": "node src/prisma/migrate-to-r2.js --dry-run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1135.0",
    "@aws-sdk/s3-request-presigner": "3.1135.0",
    "@graphql-tools/schema": "^10.1.3",
    "@opentelemetry/auto-instrumentations-node": "0.80.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@prisma/client": "5.22.0",
    "@socket.io/redis-adapter": "8.3.0",
    "@apollo/server": "5.5.1",
    "@as-integrations/express4": "1.1.2",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.1.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "engine.io": "^6.6.10",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "file-type": "21.3.4",
    "firebase-admin": "14.4.0",
    "google-auth-library": "9.14.1",
    "graphql": "^16.14.2",
    "graphql-subscriptions": "^3.0.0",
    "graphql-ws": "^6.1.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "livekit-server-sdk": "^2.6.1",
    "morgan": "^1.12.0",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.4",
    "otplib": "^12.0.1",
    "pdfkit": "^0.18.0",
    "prisma": "5.22.0",
    "prom-client": "^15.1.3",
    "socket.io": "4.8.3",
    "socket.io-adapter": "^2.5.8",
    "socket.io-parser": "^4.2.7",
    "stripe": "^17.7.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "uuid": "11.1.1",
    "winston": "^3.11.0",
    "ws": "^8.21.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "jest": "29.7.0",
    "nodemon": "^3.0.3",
    "socket.io-client": "^4.8.3",
    "supertest": "7.0.0"
  }
}
