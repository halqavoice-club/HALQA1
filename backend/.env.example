# ─── SERVER ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# ─── DATABASE ─────────────────────────────────────────────────────────────────
# XAMPP MySQL (default — no password)
DATABASE_URL="mysql://root:@localhost:3306/halqa_db"

# Connection pool tuning (optional — defaults shown)
# DB_POOL_SIZE=5          # max simultaneous connections (dev: 5, prod: 10)
# DB_POOL_TIMEOUT=10      # seconds to wait for a free connection
# SLOW_QUERY_THRESHOLD_MS=200  # log queries slower than this (dev only)

# ─── JWT ──────────────────────────────────────────────────────────────────────
# IMPORTANT: Change these to random 32+ character strings in production!
JWT_SECRET=halqa_jwt_secret_change_in_production_32chars
JWT_REFRESH_SECRET=halqa_refresh_secret_change_in_production_32chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── REDIS ────────────────────────────────────────────────────────────────────
# Used for:
#   1. Cache (voice rooms, sessions, rate-limit state)
#   2. Socket.IO Redis adapter (horizontal scaling across multiple servers)
#   3. BullMQ background job queues
#
# Without Redis the app falls back to in-memory cache and runs in
# single-server mode (Socket.IO adapter is not applied).
#
# Local development:
#   docker run -d --name halqa-redis -p 6379:6379 redis:7-alpine
#
# Production (Redis with TLS — e.g. Redis Cloud, Upstash, AWS ElastiCache):
#   REDIS_URL=rediss://:<password>@<host>:6380
#   REDIS_TLS=true
REDIS_URL=redis://localhost:6379
REDIS_TLS=false

# ─── EMAIL (optional) ─────────────────────────────────────────────────────────
# Gmail setup:
#   1. Enable 2FA on your Google account
#   2. Go to myaccount.google.com/apppasswords
#   3. Create app password for "Mail"
#   4. Use that 16-char password as SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM="Halqa System <your@gmail.com>"
OTP_EXPIRY_MINUTES=10

# ─── FILE STORAGE ─────────────────────────────────────────────────────────────
# STORAGE_TYPE=local  → saves to backend/uploads/ (development only)
# STORAGE_TYPE=r2     → uploads to Cloudflare R2 (production)
STORAGE_TYPE=local

# ─── Cloudflare R2 (required when STORAGE_TYPE=r2) ───────────────────────────
# Setup:
#   1. Cloudflare Dashboard → R2 → Create bucket (e.g. halqa-uploads)
#   2. R2 → Manage R2 API tokens → Create API token
#      Permissions: Object Read & Write on your bucket
#   3. Enable public access: R2 bucket → Settings → Public access → Allow
#   4. Copy the r2.dev URL or set a custom domain
#
# R2_ACCOUNT_ID     — Cloudflare account ID (right sidebar of any CF dashboard page)
# R2_ACCESS_KEY_ID  — from the API token you created
# R2_SECRET_ACCESS_KEY — from the API token you created
# R2_BUCKET         — bucket name
# R2_PUBLIC_URL     — public URL for the bucket
#                     Option A: https://pub-<hash>.r2.dev  (enable in bucket settings)
#                     Option B: https://files.yourdomain.com  (custom domain)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=halqa-uploads
R2_PUBLIC_URL=

# ─── RATE LIMITING ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── ADMIN IP ALLOWLIST ───────────────────────────────────────────────────────
# Comma-separated IPv4 addresses and/or CIDR ranges allowed to access admin
# routes (backup, audit, analytics). Leave empty to allow all IPs (default for
# development). Set to your office/VPN IP(s) in production.
# Example: ADMIN_IP_ALLOWLIST=203.0.113.10,10.0.0.0/8
ADMIN_IP_ALLOWLIST=

# ─── MONITORING ───────────────────────────────────────────────────────────────
# Requests slower than this (ms) are logged as warnings
SLOW_REQUEST_MS=500
# Queries slower than this (ms) are logged as warnings
SLOW_QUERY_THRESHOLD_MS=200
# Token required to access GET /metrics and GET /health/metrics
# Leave empty to disable token auth (not recommended in production)
# Prometheus scrape config: bearer_token: <value>
# curl: -H "Authorization: Bearer <value>"  or  -H "X-Metrics-Token: <value>"
METRICS_TOKEN=
# Token required to access GET /health/detailed (UIGAP-014 fix)
# /health, /health/liveness, /health/readiness, /health/startup remain public (Kubernetes probes).
# Leave empty in development to get 401 (endpoint not open without token).
# Set a strong random token in production — required or the endpoint is blocked (503).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HEALTH_TOKEN=
# Service name shown in structured logs and Prometheus labels
SERVICE_NAME=halqa-api

# ─── LIVEKIT (Voice Club audio) ───────────────────────────────────────────────
# Sign up free at https://livekit.io → create a project → copy keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# Stripe Payment Gateway (Phase B-2)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SUCCESS_URL=http://localhost:3000/wallet?payment=success
STRIPE_CANCEL_URL=http://localhost:3000/wallet?payment=cancelled
# M-9 FIX: Set STRIPE_SKIP_SIGNATURE=true ONLY in local dev to skip webhook signature
# verification when testing with the Stripe CLI simulator.
# This MUST NOT be set in production or staging. In staging, set NODE_ENV=production
# and configure a real STRIPE_WEBHOOK_SECRET instead.
# STRIPE_SKIP_SIGNATURE=true

# ─── CONTENT MODERATION ───────────────────────────────────────────────────────
# Screens message/post body text before saving to the database.
# Important for an Islamic school platform to prevent inappropriate content.
#
# CONTENT_FILTER_ENABLED=true      — enable/disable (default: true)
# CONTENT_FILTER_MODE=block        — 'block' (reject with 400) | 'flag' (allow + log)
# CONTENT_FILTER_WORDS=word1,word2 — comma-separated words to add to blocklist
#
# For production, consider upgrading to Perspective API (Google) by adding:
#   PERSPECTIVE_API_KEY=your_key_here
# The contentFilter.js utility has a hook for async API-based moderation.
CONTENT_FILTER_ENABLED=true
CONTENT_FILTER_MODE=block
CONTENT_FILTER_WORDS=

# ─── TWO-FACTOR AUTHENTICATION ───────────────────────────────────────────────
# AES-256 encryption key for TOTP secrets stored in the database.
# If not set, falls back to JWT_SECRET. Recommended: set a dedicated 32+ char key.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY=

# ─── ELASTICSEARCH (optional) ────────────────────────────────────────────────
# When set, full-text search uses Elasticsearch instead of MySQL LIKE queries.
# The app falls back to MySQL automatically when not set — no code changes needed.
# ELASTICSEARCH_URL=http://localhost:9200
# ELASTICSEARCH_USERNAME=
# ELASTICSEARCH_PASSWORD=

# ─── ALERTING ─────────────────────────────────────────────────────────────────
# Slack: Create an incoming webhook at https://api.slack.com/apps
# Set SLACK_WEBHOOK_URL to fire alert notifications to your ops channel.
# Leave empty to disable Slack alerts.
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#alerts

# PagerDuty: Create a service with Events API v2 integration
# https://support.pagerduty.com/docs/api-access-keys
PAGERDUTY_ROUTING_KEY=

# Email alerts (uses the same SMTP config above)
ALERT_EMAIL_TO=admin@yourdomain.com

# Custom webhook (optional — POST JSON payload to any endpoint)
ALERT_WEBHOOK_URL=

# ─── GOOGLE SIGN-IN ───────────────────────────────────────────────────────────
# Server-side Google credential verification.
# Backend uses GOOGLE_CLIENT_ID to verify ID tokens received from the frontend.
# Frontend uses NEXT_PUBLIC_GOOGLE_CLIENT_ID (same value) for the OAuth popup.
#
# Setup:
#   1. Google Cloud Console → APIs & Services → Credentials
#   2. Create OAuth 2.0 Client ID (Web application)
#   3. Authorized JavaScript origins: http://localhost:3000 (dev), https://yourdomain.com (prod)
#   4. Authorized redirect URIs: not required for One Tap / popup flow
#   5. Copy Client ID — add to both backend .env and frontend .env.local
#
# Multiple client IDs (web + mobile) can be comma-separated:
#   GOOGLE_CLIENT_ID=web-client-id.apps.googleusercontent.com,mobile-client-id.apps.googleusercontent.com
#
# SECURITY: Never put the Client Secret here — it is not used in this flow.
# The frontend ONLY needs GOOGLE_CLIENT_ID (public). The secret stays unused.
GOOGLE_CLIENT_ID=

# ─── SMS OTP (optional) ───────────────────────────────────────────────────────
# Provider: Twilio (https://twilio.com)
#   TWILIO_ACCOUNT_SID  — Account SID from Twilio console
#   TWILIO_AUTH_TOKEN   — Auth token from Twilio console
#   TWILIO_FROM_NUMBER  — Your Twilio phone number (e.g. +15005550006)
# Without SMS configured, OTPs are sent via email only.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
