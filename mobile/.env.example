# ─── HALQA Mobile Environment Template ─────────────────────────────────────
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to source control.
#
# .env          → your local/dev values (gitignored)
# .env.example  → this template (committed — no real values)
#
# For production builds, set these via EAS Secrets:
#   eas secret:create --scope project --name EXPO_PUBLIC_API_URL --value "https://api.yourdomain.com/api/v1"
# See: https://docs.expo.dev/build-reference/variables/
# ─────────────────────────────────────────────────────────────────────────────

# ─── API + SOCKET ────────────────────────────────────────────────────────────
# Local development: use your machine's LAN IP (not localhost — device can't
# reach localhost). Find it with `ipconfig` (Windows) or `ifconfig` (macOS/Linux).
# Production: use your actual API domain.
#
# DO NOT commit a LAN IP here. Use .env for local values.
EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:5000/api/v1
EXPO_PUBLIC_SOCKET_URL=http://YOUR_LAN_IP:5000

# Web URL (used for share links and deep links)
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# ─── LIVEKIT (Voice Club + Live Class audio/video) ───────────────────────────
# Get from https://livekit.io → your project → API Keys
# The URL is also returned by the backend token endpoint; this is the client-side
# connection URL used by the LiveKit React Native SDK.
EXPO_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# ─── STRIPE (Payments) ───────────────────────────────────────────────────────
# Publishable key — safe to expose in client code (unlike the secret key).
# Get from https://dashboard.stripe.com → Developers → API keys
# Use pk_test_... for development/staging, pk_live_... for production.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
