# HALQA Mobile — API configuration
#
# For emulator/simulator: use localhost
# For physical device on same WiFi: replace with your PC's local IP
# Find it with: ipconfig (Windows) or ifconfig (Mac/Linux)

EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1
EXPO_PUBLIC_SOCKET_URL=http://localhost:5000
EXPO_PUBLIC_LIVEKIT_URL=wss://placeholder.livekit.cloud
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key_for_development

# Web app origin — used for Voice Club share links.
# In development: http://localhost:3000 (or http://<your-PC-IP>:3000 for device testing)
# In production: set to your actual web app URL, e.g. https://app.halqa.com
EXPO_PUBLIC_WEB_URL=http://localhost:3000
